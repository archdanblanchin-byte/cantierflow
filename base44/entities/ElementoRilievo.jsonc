{
  "name": "ElementoRilievo",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Descrizione / elemento rilevato (es. Parete, Camino, Pilastro)"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}