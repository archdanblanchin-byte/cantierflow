{
  "name": "Trasferta",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data della trasferta"
    },
    "user_email": {
      "type": "string",
      "description": "Email del collaboratore"
    },
    "user_nome": {
      "type": "string",
      "description": "Nome del collaboratore (denormalizzato)"
    },
    "primo_cantiere_id": {
      "type": "string",
      "description": "ID del primo cantiere della giornata"
    },
    "primo_cantiere_nome": {
      "type": "string",
      "description": "Nome del primo cantiere"
    },
    "ultimo_cantiere_id": {
      "type": "string",
      "description": "ID dell'ultimo cantiere della giornata"
    },
    "ultimo_cantiere_nome": {
      "type": "string",
      "description": "Nome dell'ultimo cantiere"
    },
    "km_andata": {
      "type": "number",
      "description": "Km dal capannone al primo cantiere"
    },
    "km_ritorno": {
      "type": "number",
      "description": "Km dall'ultimo cantiere al capannone"
    },
    "km_totali": {
      "type": "number",
      "description": "Km totali (andata + ritorno)"
    },
    "km_media": {
      "type": "number",
      "description": "Km equivalenti della trasferta: media tra andata e ritorno"
    },
    "km_riconosciuti": {
      "type": "number",
      "description": "Km di trasferta riconosciuti: media andata/ritorno meno i km equivalenti al tempo di lavoro mancante alle 8 ore"
    },
    "km_deficit": {
      "type": "number",
      "description": "Km non riconosciuti per ore di lavoro mancanti (1 minuto mancante = 1 km)"
    },
    "minuti_mancanti": {
      "type": "number",
      "description": "Minuti di lavoro mancanti alle 8 ore giornaliere"
    },
    "fascia_andata": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4"
      ],
      "description": "Fascia calcolata sulla tratta di andata (capannone -> primo cantiere)"
    },
    "fascia_ritorno": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4"
      ],
      "description": "Fascia calcolata sulla tratta di ritorno (ultimo cantiere -> capannone)"
    },
    "tipo_trasferta": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4"
      ],
      "description": "Fascia trasferta riconosciuta, calcolata sui km equivalenti (media andata/ritorno meno il tempo mancante)"
    },
    "mezzo_proprio": {
      "type": "boolean",
      "default": false,
      "description": "Se la trasferta \u00e8 stata fatta con mezzo proprio"
    },
    "note": {
      "type": "string",
      "description": "Note sulla trasferta"
    },
    "confermata": {
      "type": "boolean",
      "default": false,
      "description": "Se l'admin ha confermato la trasferta"
    }
  },
  "required": [
    "data",
    "user_email"
  ]
}