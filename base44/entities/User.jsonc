{
  "properties": {
    "role": {
      "type": "string",
      "description": "Ruolo dell'utente nell'app",
      "enum": [
        "admin",
        "responsabile_tecnico",
        "capocantiere",
        "collaboratore"
      ]
    },
    "permessi_extra": {
      "type": "string",
      "description": "Sezione in cui l'utente ha gli stessi permessi di gestione dell'amministratore. Valore previsto: 'inventario'. Pu\u00f2 essere assegnato solo da un amministratore.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}