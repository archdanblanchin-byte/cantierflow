{
  "name": "ImpostazioneApp",
  "type": "object",
  "properties": {
    "chiave": {
      "type": "string",
      "description": "Chiave dell'impostazione (es. punti_analisi_sopraluogo, drive_rilievi_root_folder_id)"
    },
    "valore": {
      "type": "string",
      "description": "Valore dell'impostazione (testo o JSON serializzato)"
    }
  },
  "required": [
    "chiave"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "responsabile_tecnico"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "responsabile_tecnico"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}