{
  "name": "LavorazioneTipo",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome della lavorazione (es. Pittura interna)"
    },
    "ordine": {
      "type": "number",
      "default": 0,
      "description": "Ordine di visualizzazione"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}