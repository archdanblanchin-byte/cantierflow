{
  "name": "Nota",
  "type": "object",
  "properties": {
    "testo": {
      "type": "string",
      "description": "Contenuto della nota / task / comunicazione"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "task",
        "personale",
        "promemoria",
        "lista",
        "messaggio"
      ],
      "default": "personale",
      "description": "task=cosa da fare, personale=nota privata, promemoria=sveglia/data, lista=elenco materiale/attrezzi, messaggio=comunicazione a colleghi"
    },
    "items": {
      "type": "array",
      "description": "Voci della lista (per tipo=lista)",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "done": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "privata": {
      "type": "boolean",
      "default": true,
      "description": "true = nota/task personale (visibile solo all'autore + admin). false = comunicazione condivisa: visibile a destinatari, oppure a tutti se collegata a cantiere/furgone."
    },
    "cantiere_id": {
      "type": "string",
      "description": "ID cantiere collegato"
    },
    "cantiere_nome": {
      "type": "string",
      "description": "Nome cantiere (denormalizzato)"
    },
    "furgone_id": {
      "type": "string",
      "description": "ID furgone collegato"
    },
    "furgone_nome": {
      "type": "string",
      "description": "Nome furgone (denormalizzato)"
    },
    "materiali": {
      "type": "array",
      "description": "Materiali collegati alla comunicazione/nota",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          }
        }
      }
    },
    "attrezzi": {
      "type": "array",
      "description": "Attrezzi collegati alla comunicazione/nota",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          }
        }
      }
    },
    "destinatari_email": {
      "type": "array",
      "description": "Email degli utenti a cui \u00e8 riferita la nota (per visibilit\u00e0 e notifiche)",
      "items": {
        "type": "string"
      }
    },
    "destinatari_nomi": {
      "type": "array",
      "description": "Nomi dei destinatari (denormalizzati, per display)",
      "items": {
        "type": "string"
      }
    },
    "data_promemoria": {
      "type": "string",
      "format": "date-time",
      "description": "Quando ricordare (sveglia/promemoria)"
    },
    "priorita": {
      "type": "string",
      "enum": [
        "bassa",
        "media",
        "alta"
      ],
      "default": "media"
    },
    "letto_da": {
      "type": "array",
      "description": "Email degli utenti che hanno gi\u00e0 letto la nota",
      "items": {
        "type": "string"
      }
    },
    "completato": {
      "type": "boolean",
      "default": false,
      "description": "Se la nota/lista/task \u00e8 stata completata"
    },
    "completato_da": {
      "type": "string",
      "description": "Email di chi ha completato l'attivit\u00e0 (task)"
    },
    "origine": {
      "type": "string",
      "enum": [
        "manuale",
        "vocale"
      ],
      "default": "manuale"
    }
  },
  "required": [
    "testo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.destinatari_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.privata": false
            },
            {
              "data.cantiere_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.privata": false
            },
            {
              "data.furgone_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.destinatari_email": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "$and": [
            {
              "data.privata": false
            },
            {
              "data.cantiere_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.privata": false
            },
            {
              "data.furgone_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}