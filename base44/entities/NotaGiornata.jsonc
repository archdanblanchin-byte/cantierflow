{
  "name": "NotaGiornata",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date",
      "description": "Giorno a cui si riferisce la nota (yyyy-MM-dd)"
    },
    "user_email": {
      "type": "string",
      "description": "Email del dipendente che ha scritto la nota"
    },
    "user_nome": {
      "type": "string",
      "description": "Nome del dipendente (denormalizzato)"
    },
    "testo": {
      "type": "string",
      "description": "Nota libera della giornata: spiegazioni su anomalie, spostamenti, dimenticanze, visite mediche, materiale"
    }
  },
  "required": [
    "data",
    "user_email",
    "testo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "responsabile_tecnico"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}